# Cle API xAI (console.x.ai -> API Keys)
XAI_API_KEY=

# Identifiants de votre compte Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Numero WhatsApp expediteur, format: whatsapp:+14155238886 (sandbox) ou votre numero WhatsApp Business approuve
TWILIO_WHATSAPP_FROM=

# Port du serveur (Railway le fournit automatiquement, ne pas y toucher en prod)
PORT=3000
